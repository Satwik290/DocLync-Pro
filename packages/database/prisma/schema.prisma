// packages/database/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  // If you are using the pg adapter in your index.ts, you might need:
  // previewFeatures = ["adapter-pg"] 
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
}

enum AppStatus {
  PENDING
  PAID
  COMPLETED
  CANCELLED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(PATIENT)
  createdAt DateTime @default(now())

  // Relations
  doctorProfile Doctor?
  appointments  Appointment[] // As a patient
  sentMessages  Message[]
}

model Doctor {
  id             String @id @default(uuid())
  userId         String @unique
  user           User   @relation(fields: [userId], references: [id])
  specialization String
  price          Int    // Stored in cents/paise
  bio            String?
  
  appointments   Appointment[] // As a doctor
}

model Appointment {
  id        String    @id @default(uuid())
  patientId String
  patient   User      @relation(fields: [patientId], references: [id])
  doctorId  String
  doctor    Doctor    @relation(fields: [doctorId], references: [id])
  
  date      DateTime
  status    AppStatus @default(PENDING)
  paymentId String?   // Razorpay Payment ID
  
  prescriptionUrl String? // Link to Cloudinary
  createdAt       DateTime @default(now())
}

model Message {
  id        String   @id @default(uuid())
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])
  content   String
  createdAt DateTime @default(now())
}